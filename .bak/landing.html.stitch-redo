{% extends "base.html" %}

{% block title %}GloHealth AI · Clinical Telemetry & Healthcare Intelligence for Bangladesh{% endblock %}

{% block extra_css %}
<style>
  /* FIX 8: Navbar brand cleanup - unify wordmark and align with icon */
  .gh-nav__brand {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
  }
  .gh-nav__brand-badge {
    display: none !important;
  }
  .gh-nav__brand-name::after {
    content: " AI";
    font-weight: 700;
  }
</style>
{% endblock %}

{% block content %}
<div class="gh-page" style="padding-top: 0;">

    <!-- ==================== 1. HERO SECTION ==================== -->
    <section style="min-height: calc(100vh - 56px); display: flex; align-items: center; padding: 48px 0; background: #ffffff; border-bottom: 1px solid var(--gh-border);">
        <div class="gh-container" style="padding: 0 24px; width: 100%;">
            <div class="gh-grid gh-grid--2" style="gap: 64px; align-items: center; grid-template-columns: 1.1fr 0.9fr; width: 100%;">
                
                <!-- Left Column (55%) -->
                <div style="display: flex; flex-direction: column; align-items: flex-start;">
                    <!-- Badge -->
                    <div style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 4px; font-family: monospace; font-size: 12px; color: #15803d; font-weight: 600;">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background: #16a34a; display: inline-block;"></span>
                        <span>AI-POWERED · CLINICALLY VALIDATED</span>
                    </div>

                    <!-- H1 Headline -->
                    <h1 style="font-family: var(--gh-font-heading); font-size: 40px; font-weight: 700; color: #0f172a; line-height: 1.15; letter-spacing: -0.03em; margin: 16px 0 20px 0; max-width: 560px;">
                        Know what's wrong.<br />Before it gets worse.
                    </h1>

                    <!-- Subtitle -->
                    <p style="font-size: 16px; line-height: 1.6; color: #475569; margin: 0 0 28px 0; max-width: 520px;">
                        GloHealth AI predicts illnesses from your symptoms, tracks outbreaks across Bangladesh, and connects you to verified clinicians — all in one unified telemetry interface.
                    </p>

                    <!-- CTA Row -->
                    <div class="gh-row" style="gap: 16px; align-items: center; flex-wrap: wrap; margin-bottom: 28px;">
                        <a href="{{ url_for('prediction') }}" class="gh-btn gh-btn--primary" style="padding: 14px 28px; font-size: 15px; font-weight: 600; border-radius: var(--gh-radius-sm);">
                            <span class="material-symbols-outlined" style="font-size: 20px;">stethoscope</span>
                            <span>Start Free Symptom Check</span>
                        </a>
                        <a href="#how-it-works" class="gh-row" style="gap: 6px; align-items: center; font-size: 15px; font-weight: 600; color: var(--gh-primary); text-decoration: none;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
                            <span>See how it works</span>
                            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
                        </a>
                    </div>

                    <!-- Trust Telemetry Row -->
                    <div style="padding-top: 16px; border-top: 1px solid var(--gh-border); width: 100%; max-width: 520px; margin-top: 0;">
                        <div class="gh-row" style="gap: 8px; align-items: center; font-size: 13px; font-family: monospace; color: var(--gh-text-muted);">
                            <span class="material-symbols-outlined" style="font-size: 16px; color: #0d9488;">verified_user</span>
                            <span>Trusted by 1,248 users · 12,480 predictions · ISO-27799 Compliant</span>
                        </div>
                    </div>
                </div>

                <!-- Right Column (Interactive Clinical Assessment Preview) -->
                <div>
                    <div style="background: #ffffff; border: 1px solid var(--gh-border); border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(15,23,42,0.06); display: flex; flex-direction: column; gap: 14px; max-width: 480px; margin-left: auto; max-height: 460px; overflow: hidden;">
                        
                        <!-- Card Header -->
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                            <div class="gh-row" style="gap: 8px; align-items: center; padding: 4px 10px; background: #f0fdfa; border: 1px solid #ccfbf1; border-radius: 20px;">
                                <span class="material-symbols-outlined" style="font-size: 16px; color: #0d9488;">check_circle</span>
                                <span style="font-size: 12px; font-weight: 600; color: #0f766e;">AI Clinical Assessment</span>
                            </div>
                            <span style="font-family: monospace; font-size: 11px; color: #94a3b8;">Live Simulation</span>
                        </div>

                        <!-- Reported Symptoms -->
                        <div>
                            <div style="font-size: 11px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; font-weight: 600; margin-bottom: 6px;">
                                Reported Symptoms
                            </div>
                            <div class="gh-row" style="gap: 8px; flex-wrap: wrap;">
                                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 12px; font-weight: 500; color: #0f172a;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #e11d48;"></span>
                                    <span>High fever (39.4°C)</span>
                                </span>
                                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 12px; font-weight: 500; color: #0f172a;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #0d9488;"></span>
                                    <span>Joint pain</span>
                                </span>
                                <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 12px; font-weight: 500; color: #0f172a;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #0d9488;"></span>
                                    <span>Fatigue</span>
                                </span>
                            </div>
                        </div>

                        <!-- Primary Indication Box -->
                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 10px;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <div>
                                    <span style="font-size: 10px; font-family: monospace; color: #64748b; text-transform: uppercase;">PRIMARY INDICATION</span>
                                    <h3 style="font-family: var(--gh-font-heading); font-size: 18px; font-weight: 700; color: #0f172a; margin: 2px 0 0 0;">Dengue Fever</h3>
                                </div>
                                <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; background: #f0f9ff; color: #0369a1; border: 1px solid #bae6fd; border-radius: 20px; font-family: monospace; font-size: 11px; font-weight: 700;">
                                    <span style="width: 5px; height: 5px; border-radius: 50%; background: #0369a1;"></span>
                                    <span>87% Match</span>
                                </span>
                            </div>

                            <!-- Recommendation Box -->
                            <div style="background: #ffffff; border-left: 3px solid #0369a1; border-radius: 0 6px 6px 0; padding: 10px 12px; border: 1px solid #e2e8f0; border-left-width: 3px;">
                                <div style="display: flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: #0f172a; margin-bottom: 2px;">
                                    <span class="material-symbols-outlined" style="font-size: 15px; color: #0d9488;">health_and_safety</span>
                                    <span>Recommended Clinical Protocol</span>
                                </div>
                                <p style="font-size: 11.5px; color: #475569; margin: 0; line-height: 1.4;">
                                    Consult a licensed physician for a complete blood count (CBC) platelet baseline check within 24 hours.
                                </p>
                            </div>

                            <!-- Footer of Box -->
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11.5px;">
                                <div class="gh-row" style="gap: 4px; align-items: center; color: #64748b; font-size: 10.5px;">
                                    <span class="material-symbols-outlined" style="font-size: 13px; color: #0d9488;">verified</span>
                                    <span>Verified by Clinical ML Engine</span>
                                </div>
                                <a href="{{ url_for('doctors') }}" style="color: #0369a1; font-weight: 600; text-decoration: none; font-size: 11.5px;">
                                    Book specialist &rarr;
                                </a>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ==================== 2. TRUST STRIP ==================== -->
    <section style="background: #faf8ff; border-bottom: 1px solid var(--gh-border); margin-top: 0; padding: 64px 0;">
        <div class="gh-container" style="padding: 48px 24px;">
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; text-align: center;">
                <div style="border-right: 1px solid var(--gh-border); padding: 0 24px;">
                    <div style="font-family: var(--gh-font-heading); font-size: 32px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">1,248</div>
                    <div style="font-size: 11px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gh-text-muted);">Active Users</div>
                </div>
                <div style="border-right: 1px solid var(--gh-border); padding: 0 24px;">
                    <div style="font-family: var(--gh-font-heading); font-size: 32px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">12,480</div>
                    <div style="font-size: 11px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gh-text-muted);">Predictions Run</div>
                </div>
                <div style="border-right: 1px solid var(--gh-border); padding: 0 24px;">
                    <div style="font-family: var(--gh-font-heading); font-size: 32px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">96</div>
                    <div style="font-size: 11px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gh-text-muted);">Verified Doctors</div>
                </div>
                <div style="padding: 0 24px;">
                    <div style="font-family: var(--gh-font-heading); font-size: 32px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">8</div>
                    <div style="font-size: 11px; font-family: monospace; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gh-text-muted);">Divisions Covered</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== 3. FEATURES SECTION ==================== -->
    <section style="background: #ffffff; border-bottom: 1px solid var(--gh-border); padding: 80px 0;" id="features">
        <div class="gh-container" style="max-width: 1200px; padding: 0 24px;">
            <div style="text-align: center; max-width: 640px; margin-left: auto; margin-right: auto; margin-bottom: 48px;">
                <h2 style="font-family: var(--gh-font-heading); font-size: 32px; font-weight: 700; color: #0f172a; margin-bottom: 12px; text-align: center;">
                    Everything you need to stay ahead of illness
                </h2>
                <p style="font-size: 16px; color: var(--gh-text-muted); margin-bottom: 48px; max-width: 640px; margin-left: auto; margin-right: auto;">
                    Three clinical-grade telemetry modules, engineered for precision healthcare.
                </p>
            </div>

            <div class="gh-grid gh-grid--3" style="gap: 28px;">
                <!-- Card 1 -->
                <div class="gh-card" style="padding: 32px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--gh-border); transition: transform 0.15s, border-color 0.15s;" onmouseover="this.style.borderColor='var(--gh-primary)';" onmouseout="this.style.borderColor='var(--gh-border)';">
                    <div>
                        <div style="width: 48px; height: 48px; border-radius: 10px; background: #f0f9ff; color: #0369a1; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <span class="material-symbols-outlined" style="font-size: 26px;">stethoscope</span>
                        </div>
                        <h3 style="font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">AI Symptom Checker</h3>
                        <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 20px;">
                            Differential diagnosis matrix assessing 130+ clinical symptoms with instant confidence scoring tailored to Bangladesh epidemiology.
                        </p>
                    </div>
                    <div>
                        <a href="{{ url_for('prediction') }}" style="color: #0369a1; font-weight: 600; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                            <span>Run symptom check</span>
                            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
                        </a>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="gh-card" style="padding: 32px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--gh-border); transition: transform 0.15s, border-color 0.15s;" onmouseover="this.style.borderColor='var(--gh-primary)';" onmouseout="this.style.borderColor='var(--gh-border)';">
                    <div>
                        <div style="width: 48px; height: 48px; border-radius: 10px; background: #f0fdfa; color: #0d9488; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <span class="material-symbols-outlined" style="font-size: 26px;">map</span>
                        </div>
                        <h3 style="font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">Geo Outbreak Telemetry</h3>
                        <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 20px;">
                            Live epidemiological surveillance tracking active disease density and outbreaks across all 8 administrative divisions.
                        </p>
                    </div>
                    <div>
                        <a href="{{ url_for('geo_insights') }}" style="color: #0369a1; font-weight: 600; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                            <span>Explore outbreak map</span>
                            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
                        </a>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="gh-card" style="padding: 32px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--gh-border); transition: transform 0.15s, border-color 0.15s;" onmouseover="this.style.borderColor='var(--gh-primary)';" onmouseout="this.style.borderColor='var(--gh-border)';">
                    <div>
                        <div style="width: 48px; height: 48px; border-radius: 10px; background: #fdf2f8; color: #db2777; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <span class="material-symbols-outlined" style="font-size: 26px;">groups</span>
                        </div>
                        <h3 style="font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">Specialist Network</h3>
                        <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 20px;">
                            Connect with verified clinicians across Cardiology, Neurology, Dermatology, and Internal Medicine for direct consultations.
                        </p>
                    </div>
                    <div>
                        <a href="{{ url_for('doctors') }}" style="color: #0369a1; font-weight: 600; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                            <span>Find verified doctors</span>
                            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== 4. HOW IT WORKS ==================== -->
    <section style="background: #faf8ff; border-bottom: 1px solid var(--gh-border); padding: 80px 0;" id="how-it-works">
        <div class="gh-container" style="max-width: 1200px;">
            <div style="text-align: center; max-w: 640px; margin: 0 auto 48px;">
                <h2 style="font-family: var(--gh-font-heading); font-size: 32px; font-weight: 700; color: #0f172a; margin: 0 0 10px;">
                    Clinical triage in three structured steps
                </h2>
                <p style="font-size: 16px; color: #64748b; margin: 0;">
                    From symptom onset to verified specialist appointment in minutes.
                </p>
            </div>

            <div class="gh-grid gh-grid--3" style="gap: 28px;">
                <!-- Step 1 -->
                <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 28px; position: relative;">
                    <div style="font-family: monospace; font-size: 13px; font-weight: 700; color: #0369a1; margin-bottom: 12px;">
                        STEP 01
                    </div>
                    <h3 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">Log Your Symptoms</h3>
                    <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0;">
                        Select your presenting signs from our clinical library with severity rating and duration indicators.
                    </p>
                </div>

                <!-- Step 2 -->
                <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 28px; position: relative;">
                    <div style="font-family: monospace; font-size: 13px; font-weight: 700; color: #0369a1; margin-bottom: 12px;">
                        STEP 02
                    </div>
                    <h3 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">Instant Differential Match</h3>
                    <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0;">
                        Trained machine learning models cross-reference disease indicators and calculate statistical likelihoods.
                    </p>
                </div>

                <!-- Step 3 -->
                <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 28px; position: relative;">
                    <div style="font-family: monospace; font-size: 13px; font-weight: 700; color: #0369a1; margin-bottom: 12px;">
                        STEP 03
                    </div>
                    <h3 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 8px;">Connect With Clinician</h3>
                    <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0;">
                        Schedule telemedicine or in-person consultation with verified medical specialists at accredited hospitals.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== 5. CALL TO ACTION STRIP ==================== -->
    <section style="background: #00507d; color: #ffffff; padding: 64px 0; text-align: center;">
        <div class="gh-container" style="max-width: 800px;">
            <h2 style="font-family: var(--gh-font-heading); font-size: 34px; font-weight: 700; margin: 0 0 12px; color: #ffffff;">
                Ready to take control of your health?
            </h2>
            <p style="font-size: 16px; color: #cbe4ff; margin: 0 0 28px; line-height: 1.6;">
                Get immediate diagnostic clarity backed by machine learning models trained on national healthcare telemetry.
            </p>
            <div class="gh-row" style="gap: 16px; justify-content: center;">
                <a href="{{ url_for('prediction') }}" class="gh-btn" style="background: #ffffff; color: #00507d; font-weight: 700; padding: 14px 32px; font-size: 15px; border-radius: var(--gh-radius-sm);">
                    Check Symptoms Now
                </a>
                <button type="button" class="gh-btn" style="background: transparent; color: #ffffff; border: 1px solid #94ccff; padding: 14px 28px; font-size: 15px; border-radius: var(--gh-radius-sm);" data-auth-modal="signup">
                    Create Free Account
                </button>
            </div>
        </div>
    </section>

</div>

<!-- Auth Modal (Kept for instant navbar Sign in / Sign up tab switching) -->
<div id="authModal" class="gh-modal-backdrop" style="display: none;">
    <div class="gh-modal" style="max-width: 440px;">
        <div class="gh-card" style="padding: 32px;">
            <div class="gh-row" style="justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div class="gh-row" style="gap: 8px; align-items: center;">
                    <span class="gh-nav__brand-name">GloHealth AI</span>
                </div>
                <button type="button" class="gh-nav__icon-btn" id="authModalClose" aria-label="Close modal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Modal Tab Bar -->
            <div class="gh-row" style="gap: 8px; margin-bottom: 20px;">
                <button type="button" class="gh-chip is-active" id="modalTabLogin" style="flex: 1; text-align: center;">Sign in</button>
                <button type="button" class="gh-chip" id="modalTabSignup" style="flex: 1; text-align: center;">Sign up</button>
            </div>

            <!-- Dynamic Form Body -->
            <div id="authModalBody"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script src="{{ url_for('static', filename='js/auth-modal.js') }}"></script>
{% endblock %}
